AOC_BASE_URL=https://api.ephapsys.ai
AOC_ORG_ID=org_xxxxxxxxx
AOC_MODULATION_TOKEN=aoc_xxxxxxxxx
MODEL_TEMPLATE_ID=xxxxxxxxxxxxx
OUTDIR=./artifacts
AUTO_START=0
HF_TOKEN=hf_xxxxxxxxxxxxxxx

# Where modulate_local.sh installs the SDK from: pypi | local | testpypi.
# Defaults to "pypi" when unset.
MODULATOR_SDK_PACKAGE_SOURCE=pypi

# Governance mode for the modulation job: standard | indispensable.
# Defaults to "standard" when unset.
AOC_GOVERNANCE_MODE=standard

# Number of Bayesian search trials. Defaults to 2 when unset.
AOC_SEARCH_BUDGET=2

# Training steps per trial. NO default: when set, this OVERRIDES the
# maxSteps configured on the template in the web UI. Leave unset to
# honour the UI value.
# AOC_STEPS_PER_TRIAL=

# Minimum task-only warm-up steps before the indispensability term engages.
# Defaults to 1000 (or the recipe's min_steps) when unset.
INDISP_MIN_STEPS=1000

# Local JSONL training set uploaded for modulation.
AOC_DATASET_PATH=./data/train.jsonl

# Held-out eval dataset. Must be a Hugging Face dataset name —
# the AOC backend fetches it, so local file paths are NOT supported here.
HELD_OUT_DS_NAME=Salesforce/wikitext

# HF dataset config. Defaults to "wikitext-103-raw-v1" when unset.
HELD_OUT_DS_CONFIG=wikitext-103-raw-v1

# HF split expression. Defaults to "test[:200]" when unset.
HELD_OUT_SPLIT=test[:200]

# Number of eval steps. Defaults to 20 when unset.
HELD_OUT_STEPS=20
