AOC_BASE_URL=https://api.ephapsys.ai
AOC_ORG_ID=org_xxxxxxxxx
AOC_MODULATION_TOKEN=aoc_xxxxxxxxx
MODEL_TEMPLATE_ID=xxxxxxxxxxxxx
OUTDIR=./artifacts
AUTO_START=0
HF_TOKEN=hf_xxxxxxxxxxxxxxx

# Where modulate_local.sh installs the SDK from: pypi | local | testpypi.
# Defaults to "pypi" when unset.
MODULATOR_SDK_PACKAGE_SOURCE=pypi

# Governance mode for the modulation job: standard | indispensable.
# Defaults to "standard" when unset.
AOC_GOVERNANCE_MODE=standard

# Number of Bayesian search trials. Defaults to 2 when unset.
AOC_SEARCH_BUDGET=2

# Training steps per trial. NO default: when set, this OVERRIDES the
# maxSteps configured on the template in the web UI. Leave unset to
# honour the UI value.
# AOC_STEPS_PER_TRIAL=

# Minimum task-only warm-up steps before the indispensability term engages.
# Defaults to 1000 (or the recipe's min_steps) when unset.
INDISP_MIN_STEPS=1000

# Local JSONL training set uploaded for modulation.
AOC_DATASET_PATH=./data/train.jsonl

# Held-out eval dataset. Must be a Hugging Face dataset name —
# the AOC backend fetches it, so local file paths are NOT supported here.
HELD_OUT_DS_NAME=Salesforce/wikitext

# HF dataset config. Defaults to "wikitext-103-raw-v1" when unset.
HELD_OUT_DS_CONFIG=wikitext-103-raw-v1

# HF split expression. Defaults to "test[:200]" when unset.
HELD_OUT_SPLIT=test[:200]

# Number of eval steps. Defaults to 20 when unset.
HELD_OUT_STEPS=20

# ── AOC trial scoring and indispensability tunables ──────────────────────────
# All eight are read by modulators/language/train_language.py and all have
# defaults, so every line below is optional.

# Per-trial torch seed, so trials differ only by their sampled hyperparameters.
# Defaults to 42 when unset.
AOC_TRIAL_SEED=42

# Indispensability objective. "dispensability" is the legacy unbounded ratio;
# "hinge" is the bounded CE-gap objective and is EXPERIMENTAL — the SDK's paired
# forwards still run under dropout, which contaminates the measured gap.
# Falls back to the recipe's objective, then "dispensability", when unset.
INDISP_OBJECTIVE=dispensability

# Target CE gap for the hinge objective; ignored by "dispensability".
# Falls back to the recipe's margin, then 0.5, when unset.
INDISP_MARGIN=0.5

# Usability gate τ. Set to pin τ absolutely; leave unset to derive it from a
# fixed pre-Λ baseline loss measured once per search.
# AOC_USABILITY_TAU=

# Slack added to the derived baseline loss when computing τ.
# Defaults to 0.15 when unset.
AOC_USABILITY_EPS=0.15

# τ used only if the pre-Λ baseline eval fails outright.
# Defaults to 3.5 when unset.
AOC_USABILITY_TAU_FALLBACK=3.5

# Minimum indispensability gap δ_min before a trial can score as usable.
# Defaults to 1.0 when unset.
AOC_MIN_GAP=1.0

# Upper bound on the gap term, so one huge gap can't dominate the score.
# Defaults to 8.0 when unset.
AOC_GAP_CAP=8.0
